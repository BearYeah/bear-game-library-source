<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BearLibrary</AssemblyName><RootNamespace>NovaLibrary</RootNamespace>
    <Version>1.8.19</Version><Product>Bear游戏库</Product><Title>Bear游戏库</Title>
    <Company>lostlybear</Company><Authors>lostlybear</Authors>
    <ApplicationIcon>Assets\bear.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><StartupObject>NovaLibrary.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="SteamKit2" Version="3.5.0"/></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LanAssets\*.zip"/>
    <EmbeddedResource Include="Assets\SteamKit-LGPL-2.1.txt"/><EmbeddedResource Include="Assets\GPL-3.0.txt"/><EmbeddedResource Include="Assets\LGPL-3.0.txt"/>
    <Resource Include="Assets\bear-icon.png"/><Resource Include="Assets\bear.ico"/>
    <EmbeddedResource Include="Payloads\*.json"/>
    <EmbeddedResource Include="Payloads\*.dll" Condition="Exists('Payloads\standard.dll') And Exists('Payloads\families.dll')"/>
    <EmbeddedResource Include="NetAssets\curl.exe" Condition="Exists('NetAssets\curl.exe')"/>
    <EmbeddedResource Include="NetAssets\curl-ca-bundle.crt" Condition="Exists('NetAssets\curl-ca-bundle.crt')"/>
    <EmbeddedResource Include="DownloadAssets\BearDownloader.exe" Condition="Exists('DownloadAssets\BearDownloader.exe')"/>
  </ItemGroup>
</Project>
